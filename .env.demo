# OSS demo environment variables.
# Use: docker compose --env-file .env.demo up -d --build
#
# These values match docker-compose.yml defaults and docker/keycloak/nudge-realm.json.
# DO NOT use these values in production: client secret and session key are
# hardcoded for demo convenience only.

# Compose のサービス間で参照するため、一覧化された全変数。
# 実装的には docker-compose.yml が ${VAR:-default} で持つデフォルトと同じ値を
# 明示的に書き出している（既存 .env がある開発者でも demo モードを動かすため）。

# Postgres credentials inside compose
NUDGE_APP_PASSWORD=nudge_app_pass

# Web / Worker session encryption (demo only — DO NOT use in production)
IRON_SESSION_PASSWORD=nudge-demo-session-key-change-me-in-production

# Keycloak OIDC client (matches docker/keycloak/nudge-realm.json)
OIDC_CLIENT_ID=nudge-web
OIDC_CLIENT_SECRET=nudge-demo-client-secret-change-me

# Public-facing URL (browser + container both reach KC at this hostname)
# Requires Windows hosts file entry: 127.0.0.1 host.docker.internal
OIDC_REDIRECT_URI_BASE=http://host.docker.internal:3000

# Optional sync API key (cron sync uses this)
SYNC_API_KEY=demo-sync-key-change-me-in-production

# Demo runs over HTTP, so session cookies must NOT be marked Secure
# (browsers refuse Secure cookies on HTTP and OIDC state cookie would be lost)
# Production deploys over HTTPS should leave this unset (defaults to true).
COOKIE_SECURE=false
